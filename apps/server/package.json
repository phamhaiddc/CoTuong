{
  "name": "@cotuong/server",
  "version": "0.1.0",
  "private": true,
  "description": "API + WebSocket (NestJS, Socket.IO, Prisma, Redis)",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "admin:promote": "node dist/cli/promote-admin.js",
    "bots:seed": "node dist/cli/seed-bots.js",
    "smoke": "node dist/cli/smoke-test.js",
    "smoke:bots": "node dist/cli/smoke-bots.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "~3.1166.0",
    "@cotuong/ai": "0.1.0",
    "@cotuong/game-core": "0.1.0",
    "@cotuong/shared": "0.1.0",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/platform-socket.io": "^11.2.9",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/websockets": "^11.2.9",
    "@prisma/client": "^6.19.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "2.4.3",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.33.5",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.19.0",
    "socket.io-client": "^4.8.1"
  }
}
