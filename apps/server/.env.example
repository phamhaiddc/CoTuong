# Sao chép thành apps/server/.env rồi chỉnh lại.
# Ghi chú phải nằm trên dòng riêng (dòng bắt đầu bằng #): viết KEY=giá-trị # ghi chú thì "# ghi chú" thành một phần
# giá trị (vd SMTP_SECURE=true # ... không còn được hiểu là true).
NODE_ENV=development
PORT=3000

# Địa chỉ trang web (dùng cho link trong email xác thực / đặt lại mật khẩu)
APP_URL=http://localhost:5173

DATABASE_URL=postgresql://cotuong:cotuong@127.0.0.1:5432/cotuong?schema=public
REDIS_URL=redis://127.0.0.1:6379

# Bí mật ký JWT — BẮT BUỘC đổi ở production (chuỗi ngẫu nhiên dài)
JWT_SECRET=dev-only-change-me-please-0123456789abcdef
# IP người dùng sau proxy (dùng cho giới hạn số lần thử): mặc định "loopback" = chỉ tin proxy chạy cùng máy.
# Sau load balancer / CDN: đặt số tầng proxy (vd 1) hoặc dải IP của proxy. Chạy thẳng ra Internet: để mặc định.
# TRUST_PROXY=1
# Số ngày giữ phiên đăng nhập
SESSION_TTL_DAYS=7
# Cookie phiên chỉ gửi qua HTTPS (kèm header HSTS). Mặc định bật khi NODE_ENV=production hoặc APP_URL là https://;
# chỉ đặt false khi thử chế độ production qua http://localhost. Nhận true/false/1/0, giá trị khác thì server không khởi động.
# COOKIE_SECURE=false

# SMTP gửi email giao dịch: mã đăng ký, liên kết xác thực email, đặt lại mật khẩu
# (dev: Mailpit trong docker-compose, xem thư tại http://localhost:8025)
# Bỏ trống SMTP_HOST: ở dev (NODE_ENV khác production) nội dung email — kể cả MÃ ĐĂNG KÝ và link đặt lại mật khẩu — chỉ
# được in ra log server; ở production KHÔNG gửi được thư nào và KHÔNG AI ĐĂNG KÝ ĐƯỢC bằng email (đăng ký cần mã gửi qua
# email; đăng nhập Google vẫn dùng được) → production phải cấu hình SMTP.
# Dùng 127.0.0.1 (KHÔNG dùng "localhost"): docker-compose chỉ mở cổng trên 127.0.0.1, còn "localhost" trên Windows được
# hiểu thành ::1 (IPv6) trước → thư viện gửi mail báo ECONNREFUSED ::1:1025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Xe Pháo Mã <no-reply@cotuong.local>"
# (Tuỳ chọn) Địa chỉ nhận thư trả lời (Reply-To) của mọi thư; bỏ trống = không đặt
# MAIL_REPLY_TO=hotro@ten-mien-cua-ban.vn
# (Tuỳ chọn) Trần thư toàn trang (mọi instance cộng lại, đếm ở Redis): số thư mỗi giờ và mỗi 24 giờ, đếm mọi loại thư.
# Trần chia phần theo loại thư: mã đăng ký 70%, đặt lại mật khẩu 20%, liên kết xác thực 10% — loại này dùng hết phần của
# mình không lấn sang phần của loại khác. Chạm trần thì không gửi (bước 1 đăng ký trả lỗi 503) và ghi lỗi vào log.
# MAIL_MAX_PER_HOUR=100
# MAIL_MAX_PER_DAY=400
# Khi SMTP_HOST không phải máy này (127.0.0.1, ::1, localhost), thư tới tên miền thử nghiệm (.test, .example, .invalid,
# .localhost, .local) không được gửi — coi như gửi thất bại.
#
# Gửi thư thật qua Gmail (nên chỉ dùng để thử nghiệm; production nên dùng dịch vụ email giao dịch):
#  - Bật Xác minh 2 bước cho tài khoản Google, tạo Mật khẩu ứng dụng (mã 16 ký tự) tại
#    https://myaccount.google.com/apppasswords rồi điền vào SMTP_PASS (KHÔNG dùng mật khẩu đăng nhập Gmail).
#    Đổi mật khẩu tài khoản Google thì mọi mật khẩu ứng dụng bị thu hồi → phải tạo mật khẩu ứng dụng mới, nếu không mọi
#    thư (kể cả mã đăng ký) đều gửi thất bại. Nguồn: https://support.google.com/accounts/answer/185833
#  - Cổng 465 đi với SMTP_SECURE=true; cổng 587 đi với SMTP_SECURE=false (nâng lên TLS bằng STARTTLS).
#    Nguồn: https://support.google.com/a/answer/176600
#  - MAIL_FROM dùng đúng địa chỉ của SMTP_USER; muốn thư trả lời về địa chỉ khác thì đặt MAIL_REPLY_TO.
#  - Gmail giới hạn số thư gửi mỗi ngày (https://support.google.com/mail/answer/22839) → giữ MAIL_MAX_PER_DAY thấp hơn
#    giới hạn đó.
#  - Server đang gửi thư thật thì KHÔNG chạy `npm run smoke` vào nó.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=ban@gmail.com
# SMTP_PASS=mat-khau-ung-dung
# MAIL_FROM="Xe Pháo Mã <ban@gmail.com>"

# Đăng ký kiểu cũ POST /api/auth/register (tạo tài khoản CHƯA xác thực, không cần mã email; giao diện không dùng, smoke
# test dùng). Mặc định: bật khi NODE_ENV khác production, tắt ở production (tắt thì trả 404). Nhận true/false/1/0
# (không phân biệt hoa thường); giá trị khác thì server không khởi động.
# ALLOW_LEGACY_REGISTER=false

# Object storage chuẩn S3 cho avatar (dev: SeaweedFS trong docker-compose, cổng 8333)
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=avatars
S3_ACCESS_KEY_ID=cotuong
S3_SECRET_ACCESS_KEY=cotuong-secret
S3_FORCE_PATH_STYLE=true

# (Tuỳ chọn) Đăng nhập bằng Google / Facebook — bỏ trống thì nút tương ứng không hiện.
# Địa chỉ chuyển hướng (redirect URI) phải khai báo ở trang quản lý ứng dụng của Google / Facebook:
#   ${APP_URL}/api/auth/oauth/google/callback   và   ${APP_URL}/api/auth/oauth/facebook/callback
# Google: https://console.cloud.google.com/apis/credentials → "OAuth client ID" loại "Web application"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps → sản phẩm "Facebook Login", quyền email + public_profile
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# (Nâng cao) Ghi đè địa chỉ của nhà cung cấp, ví dụ ghim phiên bản Graph API của Facebook
# (thay vXX.0 bằng phiên bản hiện hành ghi trong trang quản lý ứng dụng Facebook):
# FACEBOOK_AUTH_URL=https://www.facebook.com/vXX.0/dialog/oauth
# FACEBOOK_TOKEN_URL=https://graph.facebook.com/vXX.0/oauth/access_token
# FACEBOOK_PROFILE_URL=https://graph.facebook.com/vXX.0/me?fields=id,name,email
# GOOGLE_AUTH_URL / GOOGLE_TOKEN_URL / GOOGLE_USERINFO_URL cũng ghi đè được tương tự.

# (Tuỳ chọn) Ghi đè mốc cấp bậc, ví dụ:
# TIERS_JSON=[{"name":"Kỳ vương","min":900},{"name":"Đại cao thủ","min":700},{"name":"Cao thủ","min":500},{"name":"Cao cấp","min":350},{"name":"Trung cấp","min":200},{"name":"Sơ cấp","min":100},{"name":"Tân thủ","min":null}]

# (Tuỳ chọn) Tài khoản máy chơi (tạo bằng: npm run bots:seed -w @cotuong/server):
# người chơi chờ ở hàng chờ XẾP HẠNG quá số giây này mà chưa có đối thủ thì được ghép với một tài khoản máy đang rảnh.
# Mặc định 30; 0 = tắt. Không áp dụng cho phòng riêng, cờ úp, trang đấu với máy.
# BOT_FALLBACK_SEC=30
# Mỗi loại tìm trận xếp hạng có 7 máy riêng (cờ tướng 7, cờ vua 7; mỗi nhóm 3 Trung bình + 4 Khó).
# Đang có NHIỀU HƠN số thành viên (có tài khoản, không tính khách) online này trên toàn hệ thống thì không ghép máy nữa
# (người chơi chờ người).
# BOT_MAX_ONLINE_HUMANS=50

# (Tuỳ chọn) Thư mục frontend đã build để server phục vụ luôn (production 1 tiến trình). Build trước bằng "npm run build";
# thư mục chưa có index.html thì server ghi cảnh báo lúc khởi động và không phục vụ giao diện.
# WEB_DIST_DIR=../web/dist
