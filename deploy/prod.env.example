# Cấu hình production — sao chép thành deploy/prod.env rồi điền giá trị thật:
#   cp deploy/prod.env.example deploy/prod.env
# KHÔNG đưa deploy/prod.env lên git / chia sẻ (chứa mật khẩu).
# Cách viết (Docker Compose đọc tệp này):
#   - Giá trị có ký tự $ phải đặt trong nháy đơn, vd SMTP_PASS='ab$cd12' — không có nháy thì Compose hiểu $cd12 là tên
#     biến và cắt mất (giá trị thành "ab", chỉ in một dòng cảnh báo).
#   - Ghi chú để trên dòng riêng, bắt đầu bằng #. ("KHOA=giá-trị # ghi chú": Compose bỏ phần " # ghi chú", nhưng dễ nhầm.)
# Tạo chuỗi ngẫu nhiên: openssl rand -hex 32

# ---- Tên miền (đã trỏ bản ghi A/AAAA về IP server; cổng 80 + 443 mở ra Internet) ----
DOMAIN=vuaco.ten-mien-cua-ban.vn
# Địa chỉ trang web (dùng trong email, đường dẫn đăng nhập Google/Facebook) — https:// + DOMAIN, không có / ở cuối
APP_URL=https://vuaco.ten-mien-cua-ban.vn

# ---- Cơ sở dữ liệu (container postgres tự tạo theo các giá trị này ở LẦN CHẠY ĐẦU) ----
POSTGRES_USER=vuaco
# Chỉ dùng chữ và số (mật khẩu nằm trong URL kết nối): openssl rand -hex 24
POSTGRES_PASSWORD=doi-thanh-chuoi-ngau-nhien
POSTGRES_DB=vuaco

# ---- Bí mật ký phiên đăng nhập: BẮT BUỘC, ≥ 32 ký tự ngẫu nhiên (openssl rand -hex 32). Đổi giá trị = mọi người bị đăng xuất
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
SESSION_TTL_DAYS=7
# Cookie phiên chỉ gửi qua HTTPS (kèm header HSTS): tự bật ở production — chỉ tắt (false) khi thử qua http://localhost
# COOKIE_SECURE=true

# ---- Email (BẮT BUỘC để đăng ký bằng email / đặt lại mật khẩu). Ví dụ Gmail + Mật khẩu ứng dụng — xem README "Gửi email"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ban@gmail.com
# Mật khẩu có ký tự $ thì đặt trong nháy đơn: SMTP_PASS='...'
SMTP_PASS=mat-khau-ung-dung-16-ky-tu
MAIL_FROM="Xe Pháo Mã <ban@gmail.com>"
# MAIL_REPLY_TO=hotro@ten-mien-cua-ban.vn
# Trần số thư cả trang (đặt thấp hơn giới hạn của nhà cung cấp email)
# MAIL_MAX_PER_HOUR=100
# MAIL_MAX_PER_DAY=400

# ---- Ảnh đại diện: mặc định dùng dịch vụ s3 (SeaweedFS) trong docker-compose.prod.yml. Dịch vụ này KHÔNG kiểm tra khoá
# (điền gì cũng được) và chỉ app với tới được (mạng nội bộ backend, không mở cổng).
# Dùng S3 của nhà cung cấp khác (AWS S3, Cloudflare R2, …): đặt thêm S3_ENDPOINT và điền đúng khoá của nhà cung cấp.
S3_REGION=us-east-1
S3_BUCKET=avatars
S3_ACCESS_KEY_ID=vuaco
S3_SECRET_ACCESS_KEY=chi-can-khi-dung-s3-ben-ngoai
# S3_ENDPOINT=https://<id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true

# ---- (Tuỳ chọn) Đăng nhập Google / Facebook — redirect URI phải đăng ký đúng:
#   https://<DOMAIN>/api/auth/oauth/google/callback   và   https://<DOMAIN>/api/auth/oauth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- (Tuỳ chọn) Máy chơi ghép trận xếp hạng — README mục "Tài khoản máy chơi"
# BOT_FALLBACK_SEC=30
# BOT_MAX_ONLINE_HUMANS=50

# ---- (Tuỳ chọn) Áp dụng migration cơ sở dữ liệu lúc app khởi động (mặc định true). Chạy nhiều bản app: đặt false cho
# các bản phụ.
# RUN_MIGRATIONS=true

# ---- (Tuỳ chọn) Đứng sau web server / CDN khác — README "Triển khai bằng Docker" → "Đứng sau web server / CDN khác".
# Mặc định (không có gì đứng trước Caddy) KHÔNG đặt các biến dưới đây.
# Ví dụ: nginx/Apache trên chính server này đã chiếm cổng 80/443, tự lo HTTPS rồi chuyển tiếp HTTP vào Caddy:
# HTTP_PORT=127.0.0.1:8080
# HTTPS_PORT=127.0.0.1:8443
# SITE_ADDRESS=http://vuaco.ten-mien-cua-ban.vn
# TRUSTED_PROXIES=private_ranges
# TRUST_PROXY=2
